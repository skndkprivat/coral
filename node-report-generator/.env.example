# ============================================
# LANGUAGE CONFIGURATION
# ============================================
# Supported languages: en (English), da (Danish), fr (French)
LANG=da

# ============================================
# OUTPUT CONFIGURATION
# ============================================
# Directory where reports will be saved
OUTPUT_DIR=./output/reports

# Report Format
# Supported formats: json, csv, txt, html
# For Genesys analysis, html format is recommended for best visualization
REPORT_FORMAT=html

# ============================================
# REPORT MODE
# ============================================
# Mode: 'sample' for sample data testing, 'genesys' for Genesys Cloud data
REPORT_MODE=sample

# ============================================
# GENESYS CLOUD CONFIGURATION
# ============================================
# Required when REPORT_MODE=genesys
# Get your credentials from: https://apps.mypurecloud.de/developer-tools/

# Client Credentials (OAuth)
GENESYS_CLIENT_ID=your_client_id_here
GENESYS_CLIENT_SECRET=your_client_secret_here

# Region
# Supported regions:
# - mypurecloud.de (Frankfurt, Germany - EMEA)
# - mypurecloud.com (US East)
# - mypurecloud.com.au (Sydney, Australia)
# - mypurecloud.ie (Dublin, Ireland - EMEA)
# - mypurecloud.jp (Tokyo, Japan)
GENESYS_REGION=mypurecloud.de

# ============================================
# ANALYSIS SETTINGS
# ============================================
# Number of days to analyze (1-90)
ANALYSIS_DAYS=30

# Number of top customer journeys to show (1-50)
# If there are more journeys, only the top N will be displayed
TOP_N_JOURNEYS=10
